  m_Script: {fileID: 11500000, guid: 6c1e207badb2d6832939f03b5a97bd41, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroOverlay
  introText: 'The Year doesn''t matter.


    You''re on vacation. At least you thought
    you were. You''ve been stuck in a bureaucratic hellscape for the last few days.


    You''re
    finally at the checkpoint, but people seem distraught, and the entry requirements
    seem all over the place.


    Ask people, find clues, and figure out what you
    need to put on your papers so you can finally have your vacation.'
  typeDelay: 0.04
  pauseAfterTyping: 3
  fadeDuration: 0.7
  fontSize: 42
  textColor: {r: 1, g: 1, b: 1, a: 1}
